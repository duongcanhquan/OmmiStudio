# LYON Studio — optional bootstrap env
# Secrets now live in server/settings.json (manage via UI → Settings).
# This file can still seed the first settings.json on first boot.

PORT=3001

# Optional first-run seed (copied into settings.json once, then UI owns it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_APPLICATION_CREDENTIALS=
GDRIVE_FOLDER_ID=
